<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Detail Report: {{ result.name }}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; color: #333; }
    h1 { color: #2c3e50; }
    .meta { color: #666; font-size: 0.9em; margin-bottom: 8px; }
    .description { background: #fef9e7; border-left: 4px solid #f39c12; padding: 10px 16px; margin-bottom: 20px; }
    .sql-block { background: #2c3e50; color: #ecf0f1; padding: 14px; font-family: monospace; font-size: 0.9em; border-radius: 4px; white-space: pre-wrap; margin-bottom: 20px; }
    .warning { background: #fdecea; border-left: 4px solid #e74c3c; padding: 10px 16px; margin-bottom: 16px; }
    table { border-collapse: collapse; width: 100%; font-size: 0.88em; }
    th { background: #2c3e50; color: #fff; padding: 8px 12px; text-align: left; white-space: nowrap; }
    td { padding: 7px 12px; border-bottom: 1px solid #ddd; word-break: break-word; max-width: 300px; }
    tr:nth-child(even) td { background: #f5f5f5; }
  </style>
</head>
<body>
  <h1>Detail Report: {{ result.name }}</h1>
  <div class="meta">Generated: {{ generated_at }}</div>

  <div class="description">
    <strong>Rule:</strong> {{ result.nl_description }}
  </div>

  <div class="sql-block">{{ result.sql }}</div>

  {% set not_impacted = result.total_rows - result.violation_count %}
  {% set ratio = (not_impacted / result.total_rows * 100) if result.total_rows > 0 else 0 %}
  <table style="width:auto; margin-bottom:20px; border:1px solid #ddd;">
    <tr>
      <th style="background:#2c3e50;color:#fff;padding:8px 16px;">Source Table</th>
      <th style="background:#2c3e50;color:#fff;padding:8px 16px;">Total Records</th>
      <th style="background:#2c3e50;color:#fff;padding:8px 16px;">Violations</th>
      <th style="background:#2c3e50;color:#fff;padding:8px 16px;">Not Impacted</th>
    </tr>
    <tr>
      <td style="padding:8px 16px;">{{ result.source_table }}</td>
      <td style="padding:8px 16px; text-align:right;">{{ result.total_rows }}</td>
      <td style="padding:8px 16px; text-align:right; color:#e74c3c; font-weight:bold;">{{ result.violation_count }}</td>
      <td style="padding:8px 16px; text-align:right; color:#27ae60; font-weight:bold;">{{ not_impacted }} ({{ "%.1f"|format(ratio) }}%)</td>
    </tr>
  </table>

  {% if truncated %}
  <div class="warning">
    Showing first {{ max_rows }} of {{ result.violation_count }} violating rows.
  </div>
  {% endif %}

  {% if rows %}
  <table>
    <thead>
      <tr>
        {% for col in result.columns %}
        <th>{{ col }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
      <tr>
        {% for cell in row %}
        <td>{{ cell if cell is not none else '' }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No violating rows found.</p>
  {% endif %}
</body>
</html>

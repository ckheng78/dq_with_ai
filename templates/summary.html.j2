<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Data Quality Summary Report</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; color: #333; }
    h1 { color: #2c3e50; }
    .meta { color: #666; font-size: 0.9em; margin-bottom: 24px; }
    table { border-collapse: collapse; width: 100%; }
    th { background: #2c3e50; color: #fff; padding: 10px 14px; text-align: left; }
    td { padding: 9px 14px; border-bottom: 1px solid #ddd; }
    tr:nth-child(even) td { background: #f5f5f5; }
    .pass { color: #27ae60; font-weight: bold; }
    .fail { color: #e74c3c; font-weight: bold; }
    .total-row td { font-weight: bold; background: #ecf0f1; }
  </style>
</head>
<body>
  <h1>Data Quality Summary Report</h1>
  <div class="meta">Generated: {{ generated_at }} &nbsp;|&nbsp; Total rows in dataset: {{ total_rows | int }}</div>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Rule</th>
        <th>Description</th>
        <th>Violations</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      {% for r in results %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>{{ r.name }}</td>
        <td>{{ r.nl_description }}</td>
        <td>{{ r.violation_count }}</td>
        <td class="{{ 'pass' if r.violation_count == 0 else 'fail' }}">
          {{ 'PASS' if r.violation_count == 0 else 'FAIL' }}
        </td>
      </tr>
      {% endfor %}
      <tr class="total-row">
        <td colspan="3">Total Violations</td>
        <td>{{ results | sum(attribute='violation_count') }}</td>
        <td></td>
      </tr>
    </tbody>
  </table>
</body>
</html>
